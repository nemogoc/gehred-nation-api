generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  email       String?    @unique
  phone       String?
  passwordHash String?
  displayName String
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles    UserRole[]
  contacts Contact[]
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Contact {
  id          String   @id @default(uuid())
  userId      String?
  firstName   String
  lastName    String
  nickname    String?
  birthday    DateTime?
  anniversary DateTime?
  primaryEmail String?
  primaryPhone String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?          @relation(fields: [userId], references: [id])
  families FamilyMember[]
}

model Family {
  id    String @id @default(uuid())
  name  String
  notes String?

  members FamilyMember[]
}

model FamilyMember {
  familyId String
  contactId String
  relationshipRole String?

  family  Family  @relation(fields: [familyId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id])

  @@id([familyId, contactId])
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}
